# ============================================
# Juntoo - Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o arquivo .env com valores reais
# ============================================

# ─── Supabase (Frontend - chaves públicas) ───
# Estas são chaves PUBLISHABLE (anon key) - seguras para o frontend
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# ─── Supabase (duplicadas sem prefixo VITE_ para Edge Functions) ───
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJ...your-anon-key

# ============================================
# SECRETS (NÃO vão no .env - configurar via Lovable Secrets ou Supabase Dashboard)
# ============================================
# SUPABASE_SERVICE_ROLE_KEY  → Supabase Dashboard > Settings > API
# SUPABASE_ANON_KEY          → Supabase Dashboard > Settings > API
# LOVABLE_API_KEY            → Gerenciado automaticamente pelo Lovable
# VAPID_PUBLIC_KEY           → Gerada para Web Push notifications
# VAPID_PRIVATE_KEY          → Gerada para Web Push notifications
#
# ⚠️  NUNCA coloque service_role_key, private keys ou tokens no .env
# ⚠️  Use o painel de Secrets do Lovable ou Supabase Dashboard
